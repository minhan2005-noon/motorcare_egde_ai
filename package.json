{
  "name": "motorcare-edge-ai",
  "version": "1.0.0",
  "description": "Motor monitoring dashboard and API for MotorCare Edge AI",
  "homepage": "https://github.com/minhan2005-noon/motorcare_egde_ai#readme",
  "bugs": {
    "url": "https://github.com/minhan2005-noon/motorcare_egde_ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhan2005-noon/motorcare_egde_ai.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "main": "ma_nguon/may_chu/may_chu.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:server && npm run test:ai",
    "test:server": "NODE_ENV=test DB_PATH=:memory: node --test ma_nguon/kiem_thu/may_chu/*.kiem_thu.js",
    "test:ai": "python3 -m unittest discover -s ma_nguon/kiem_thu/tri_tue_nhan_tao -p 'test_*.py'",
    "test:firmware": "platformio run",
    "start": "node ma_nguon/may_chu/may_chu.js",
    "dev": "nodemon ma_nguon/may_chu/may_chu.js",
    "db:check": "node scripts/kiem_tra_co_so_du_lieu.js",
    "db:seed": "node ma_nguon/may_chu/co_so_du_lieu/tao_du_lieu_mau.js",
    "vercel-build": "node scripts/chuan_bi_vercel.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
