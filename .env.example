PORT=3000
DB_PATH=./data/motorcare.sqlite
# Production Vercel: để trống DB_PATH và cấu hình đồng thời hai biến Turso này.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SESSION_DAYS=7
RESET_TOKEN_MINUTES=15
ALLOWED_ORIGINS=http://localhost:3000
SKIP_SEED=0
DEVICE_OFFLINE_SECONDS=90
AI_ALERT_THRESHOLD=0.5

# Gmail: bật xác minh 2 bước rồi tạo App Password 16 ký tự.
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=MotorCare Edge AI <your-email@gmail.com>
